+class RuleGate:
+    """ai-capstone (codi_rule_gate.patch, TRAINING_PROTOCOL section 12): per-item attention gate for start-last RuleChain
+    ("Rule 1: ... Rule n: ... Start with x. What is the final number?\n<bot>"). Nothing but the masks changes.
+      question pass: each rule attends only to itself, so rule j's keys and values hold nothing about other rules;
+                     the tail (" Start" onward, with <bot>) attends only to itself;
+      latent pass i: sees the tail and rule i+1, if that is not the last rule;
+      answer tokens: see the tail and the last rule.
+    Latents and answer tokens always see earlier latents. The first real token, GPT-2's attention sink, stays visible
+    everywhere. scripts/eval_codi.py uses this class too, so training and evaluation share one rule."""
+
+    def __init__(self, ids, mask):
+        real = mask.bool()
+        rule = ((ids == 31929) | (ids == 14330)) & real  # GPT-2 ids of "Rule", " Rule"
+        tail = ((ids == 7253) & real).long().cumsum(1) > 0  # " Start" onward
+        self.n = rule.sum(1, keepdim=True)
+        assert (self.n > 0).all() and tail.any(1).all() and not (rule & tail).any(), "rule_gate needs start-last RuleChain questions"
+        self.g = torch.where(tail, torch.zeros_like(ids), rule.long().cumsum(1)).masked_fill(~real, -1)
+        self.sink = real & (real.long().cumsum(1) == 1)
+
+    def question(self, dtype):
+        """[B, 1, W, W] additive mask for the question pass. Pad rows see only themselves, so no row is empty."""
+        g = self.g
+        w = g.size(1)
+        see = (g[:, :, None] == g[:, None, :]) | self.sink[:, None, :]
+        see = see & (g[:, None, :] >= 0) & torch.ones(w, w, dtype=torch.bool, device=g.device).tril()
+        see = see | (torch.eye(w, dtype=torch.bool, device=g.device) & (g[:, :, None] < 0))
+        return torch.zeros(see.shape, dtype=dtype, device=g.device).masked_fill(~see, torch.finfo(dtype).min)[:, None]
+
+    def latent(self, i):
+        """[B, W] keys visible to latent pass i (from 0)."""
+        return ((self.g == 0) | self.sink | ((self.g == i + 1) & (i + 1 < self.n))).long()
+
+    def answer(self):
+        """[B, W] keys visible to the answer tokens."""
+        return ((self.g == 0) | self.sink | (self.g == self.n)).long()
+
