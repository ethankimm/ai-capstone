+    def explain_loss(self, latents, steps):
+        """SIM-CoT's step loss, one decoder call for all (item, latent) pairs: token-mean CE per latent, then the mean over
+        latents that have a step in this batch. latents[j] [B, 1, D] is what pass j reads; it writes teacher step j+1."""
+        pairs = [(b, j) for b, row in enumerate(steps) for j in range(len(row))]
+        if not pairs:
+            return latents[0].new_zeros(()), []
+        assert max(j for _, j in pairs) < len(latents), "more teacher steps than latents"
+        dev, pad, L = latents[0].device, self.pad_token_id, max(len(steps[b][j]) for b, j in pairs)
+        ids = torch.tensor([steps[b][j] + [pad] * (L - len(steps[b][j])) for b, j in pairs], device=dev)
+        b_idx, j_idx = (torch.tensor(x, device=dev) for x in zip(*pairs))
+        z = torch.cat(latents, dim=1)[b_idx, j_idx].unsqueeze(1)  # [N, 1, D]
+        embds = torch.cat((z.float(), self.get_embd(self.codi, self.model_name)(ids).float()), dim=1)
+        real = ids != pad
+        mask = torch.cat((torch.ones_like(real[:, :1]), real), dim=1).long()
+        logits = self.decoder(inputs_embeds=embds, attention_mask=mask).logits[:, :-1]  # position t predicts token t
+        ce = F.cross_entropy(logits.reshape(-1, logits.size(-1)).float(), ids.masked_fill(~real, -100).reshape(-1), ignore_index=-100, reduction="none").view_as(ids)
+        per = [ce[j_idx == j][real[j_idx == j]].mean() for j in sorted(set(j_idx.tolist()))]
+        return torch.stack(per).mean(), [float(x.detach()) for x in per]
