 class CustomTrainer(Trainer):
+    def create_optimizer(self):
+        # step_decoder: the decoder is a full fine-tune, so it gets its own rate and CODI's parameters keep --learning_rate.
+        # Added groups go last, so the logged learning rate stays CODI's; the same cosine schedule scales both.
+        opt = super().create_optimizer()
+        if self.args.step_decoder:
+            mine = {id(p) for p in self.model.decoder.parameters()}
+            for g in list(opt.param_groups):
+                dec = [p for p in g["params"] if id(p) in mine]
+                g["params"] = [p for p in g["params"] if id(p) not in mine]
+                opt.add_param_group({**{k: v for k, v in g.items() if k != "params"}, "params": dec, "lr": self.args.decoder_lr})
+            print("optimizer groups (params, lr):", [(len(g["params"]), g["lr"]) for g in opt.param_groups], flush=True)
+        return opt
