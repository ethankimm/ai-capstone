+def teacher_steps(ref_input_ids, end_id):
+    """Per item, the token ids of each <<...>> step in the teacher sequence, each ending in end_id. As SIM-CoT's get_steps, but
+    it scans the whole row: the teacher text holds only the steps it was given, so with include_last_cot False the last rule
+    has no step."""
+    out = []
+    for seq in ref_input_ids.tolist():
+        steps, start = [], None
+        for i, t in enumerate(seq):
+            if t in STEP_OPEN:
+                start = i
+            elif t == STEP_CLOSE and start is not None:
+                steps.append(seq[start:i + 1] + [end_id])
+                start = None
+        out.append(steps)
+    return out
+
